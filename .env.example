# --- Issue #116: NestJS + Prisma ---
# Copy to .env and fill values.
#
# Postgres + API in Docker: `docker compose up --build` (API image uses DATABASE_URL with host `postgres` from compose; no need to change DATABASE_URL below for that).
# Nest on your machine only: start Postgres with compose or locally, then `npm run start:dev` using DATABASE_URL below (localhost).
#
# Docker API: `DATABASE_URL` below is for the host only. Compose injects `...@postgres:5432/...` into the api container; avoid `env_file` that redefines DATABASE_URL for `api`.
#
# Postgres published on host (override with POSTGRES_PORT if needed):
PORT=3000
# Optional override read by Nest ConfigModule (falls back to PORT).
APP_PORT=3000
POSTGRES_PORT=5432
POSTGRES_DB=therun
POSTGRES_USER=therun
POSTGRES_PASSWORD=therun
# Must match POSTGRES_* and host port above (Prisma does not expand ${...} inside DATABASE_URL by default).
DATABASE_URL="postgresql://therun:therun@localhost:5432/therun?schema=public"

# --- Integrations (later issues) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
ACCES_TOKEN=
REFRESH_TOKEN=

JWT_SECRET=

IOS_TEAM_ID=
APP_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINT=
