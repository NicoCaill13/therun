// Core entities (GitHub issue #117). PhantomTrace must not reference User (anonymized B2B heatmap points).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id @default(cuid())
  garminToken String?
  stravaToken String?

  spontaneousRuns   SpontaneousRun[]
  administeredCrews Crew[]           @relation("CrewAdmin")

  @@map("users")
}

model SpontaneousRun {
  id              String   @id @default(cuid())
  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  latitude        Float
  longitude       Float
  startTime       DateTime
  vibe            String
  maxParticipants Int
  status          String

  @@index([latitude, longitude])
  @@map("spontaneous_runs")
}

/// Anonymized GPS samples for heatmaps. No relation to User by design.
model PhantomTrace {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  @@index([latitude, longitude])
  @@map("phantom_traces")
}

model Crew {
  id         String  @id @default(cuid())
  name       String
  adminId    String
  admin      User    @relation("CrewAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  isVerified Boolean @default(false)

  @@map("crews")
}
