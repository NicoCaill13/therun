// Core entities (GitHub issue #117). PhantomTrace must not reference User (anonymized B2B heatmap points).
// Run participants & run status: GitHub issue #122.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id @default(cuid())
  garminToken String?
  stravaToken String?

  /// Last device-reported position for radar / nearby run notifications (issue #113).
  lastKnownLatitude  Float?
  lastKnownLongitude Float?
  expoPushToken      String?

  createdRuns       SpontaneousRun[] @relation("CreatedRuns")
  participations  RunParticipant[]
  administeredCrews Crew[]           @relation("CrewAdmin")

  createdAt DateTime @default(now())

  @@map("users")
}

model SpontaneousRun {
  id              String   @id @default(cuid())
  creatorId       String
  creator         User     @relation("CreatedRuns", fields: [creatorId], references: [id], onDelete: Cascade)
  locationName    String
  latitude        Float
  longitude       Float
  startTime       DateTime
  maxParticipants Int      @default(15)
  vibe            String
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())

  participants RunParticipant[]

  @@index([latitude, longitude])
  @@map("spontaneous_runs")
}

model RunParticipant {
  userId   String
  runId    String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  run      SpontaneousRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  joinedAt DateTime       @default(now())

  @@id([userId, runId])
  @@map("run_participants")
}

/// Anonymized GPS samples for heatmaps. No relation to User by design.
model PhantomTrace {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  @@index([latitude, longitude])
  @@map("phantom_traces")
}

model Crew {
  id         String  @id @default(cuid())
  name       String
  adminId    String
  admin      User    @relation("CrewAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  isVerified Boolean @default(false)

  @@map("crews")
}
